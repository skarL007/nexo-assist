# Copie para .env e preencha. Nunca commite o .env.

# LLM (obrigatório para o agent responder) — chave do Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=google/gemini-3.5-flash

# Banco: arquivo local em dev; no deploy, a URL e o token do Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Assina o cookie de sessão. Em produção use 32+ caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Simulação do sistema legado: chance de falha por chamada (0 a 1)
LEGACY_FAILURE_RATE=0.15

# Teto de respostas do agent em 24h (proteção de custo no deploy)
DAILY_AGENT_TURN_LIMIT=500
