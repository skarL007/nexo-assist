# Copie para .env e preencha. Nunca commite o .env.

# LLM (obrigatório para o agent responder) — chave do Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=google/gemini-3.5-flash

# Opcional: OpenRouter — `npm run benchmark` e LLM_MODEL=openrouter/<fornecedor>/<modelo>.
# Use uma chave só para isso, com limite de gasto definido no painel do OpenRouter.
OPENROUTER_API_KEY=
# Raciocínio pedido pelo OpenRouter: none | minimal | low | medium | high (padrão minimal)
OPENROUTER_REASONING_EFFORT=

# Banco: arquivo local em dev; no deploy, a URL e o token do Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Assina o cookie de sessão. Em produção use 32+ caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Simulação do sistema legado: chance de falha por chamada (0 a 1)
LEGACY_FAILURE_RATE=0.15

# Porta de acesso do deploy: só entra quem abrir /?access=<token>. Vazio = aberto (dev).
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# Teto de respostas do agent em 24h (proteção de custo no deploy)
DAILY_AGENT_TURN_LIMIT=500

# Opcional: teto TOTAL de respostas do modelo (gasto fixo da demonstração). Vazio = sem teto.
# Conta só respostas que chamaram o modelo; o seed zera a contagem.
TOTAL_AGENT_TURN_LIMIT=
