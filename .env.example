# Copie para .env e preencha. Nunca commite o .env.

# LLM (obrigatório para o agent responder) — chave do Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=google/gemini-3.5-flash

# Opcional: OpenRouter — `npm run benchmark` e LLM_MODEL=openrouter/<fornecedor>/<modelo>.
# Use uma chave só para isso, com limite de gasto definido no painel do OpenRouter.
OPENROUTER_API_KEY=
# Raciocínio pedido pelo OpenRouter: none | minimal | low | medium | high (padrão minimal)
OPENROUTER_REASONING_EFFORT=

# Banco: arquivo local em dev; no deploy, a URL e o token do Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Assina o cookie de sessão. Em produção use 32+ caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Simulação do sistema legado: chance de falha por chamada (0 a 1)
LEGACY_FAILURE_RATE=0.15

# Segredo da porta de acesso do deploy: assina os links temporários (npm run access-link). Vazio = aberto (dev).
# Nunca vai no link: o link leva só a validade e a assinatura.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# Teto de respostas do agent em 24h (proteção de custo no deploy)
DAILY_AGENT_TURN_LIMIT=500

# Opcional: teto TOTAL de respostas do modelo (gasto fixo da demonstração). Vazio = sem teto.
# Cada turno reserva uma vaga antes de chamar o modelo (inclusive os que falham); o seed zera a contagem.
TOTAL_AGENT_TURN_LIMIT=

# Opcional: telemetria dos turnos do agent (OpenTelemetry, convenções GenAI). Sem nada, desligada.
# Langfuse: as duas chaves bastam (LANGFUSE_BASE_URL padrão: https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Ou qualquer coletor OTLP/HTTP (ex.: npm run otel:local → http://127.0.0.1:4318/v1/traces)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# "true" manda também o texto da conversa e os argumentos das tools (dado pessoal: deixe vazio)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=

# Opcional: SSO com OpenID Connect (Entra ID, Google Workspace, Okta...). Sem as três primeiras, só e-mail e senha.
# Redirect URI a cadastrar no provedor: https://<seu-domínio>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Microsoft
OIDC_ALLOWED_DOMAIN=nexo.com.br
