{
  "uid": "nexo-assist",
  "title": "Farol Desk · agent e busca",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "nexo-assist"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Turnos por minuto, por resultado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(nexo_agent_turns_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Duração do turno (p50 e p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nexo_agent_turn_duration_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexo_agent_turn_duration_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens por hora, por direção",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(nexo_llm_tokens_total[1h])) * 3600",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Turnos com erro (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(nexo_agent_turns_total{outcome=\"error\"}[15m])) / clamp_min(sum(rate(nexo_agent_turns_total[15m])), 1e-9)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Modelo reserva em uso (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(nexo_agent_turns_total{outcome=\"fallback\"}[15m])) / clamp_min(sum(rate(nexo_agent_turns_total[15m])), 1e-9)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Buscas por veredito do avaliador",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(nexo_retrieval_total[15m])) * 60",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Buscas degradadas (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(nexo_retrieval_degraded_total[15m])) / clamp_min(sum(rate(nexo_retrieval_total[15m])), 1e-9)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Busca p95 (portão 2,5 s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexo_retrieval_duration_seconds_bucket[30m])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Similaridade do 1º candidato (mediana)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nexo_retrieval_top_similarity_bucket[1h])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Confiança do agent (mediana)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nexo_agent_confidence_bucket[1h])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ferramentas: p95 por ferramenta",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(nexo_tool_duration_seconds_bucket[15m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Regras do código por hora",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nexo_guardrails_total[1h])) * 3600",
          "legendFormat": ""
        }
      ]
    }
  ]
}